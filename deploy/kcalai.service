[Unit]
Description=kcalAI-model FastAPI (Gemini vision + 식약처 DB)
# Postgres 동거이므로 DB 준비 후 기동한다.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# provision.sh가 채워 넣는다(실행 사용자·경로). 실행 사용자는 sudo 없는 전용 계정이다(2026-10-22) —
# 앱이 뚫려도 서버 전체(root)로 번지지 않는다. 코드는 배포 사용자(ubuntu)가 올리고 이 계정은 읽기만 한다.
User=__SERVICE_USER__
Group=__SERVICE_USER__
# repo 루트. load_dotenv()가 cwd 기준으로 .env를 찾으므로 WorkingDirectory가 중요하다.
WorkingDirectory=__APP_DIR__
# 리버스 프록시(Caddy/nginx) 뒤에 두므로 로컬호스트에만 바인딩한다.
ExecStart=__APP_DIR__/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# 크래시·재부팅 자동 복구.
KillSignal=SIGINT
TimeoutStopSec=10
# 보호 옵션(2026-10-22). 파일 시스템은 읽기 전용이고, 앱이 쓰는 곳은 task-logs/(log_utils 의 파일 로그)
# 하나뿐이라 그곳만 연다. 업로드 임시 파일은 PrivateTmp 의 /tmp 에 쓴다. 쓰는 곳이 늘면 ReadWritePaths 에 더한다.
ReadWritePaths=__APP_DIR__/task-logs
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
