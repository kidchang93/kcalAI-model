# Caddy 리버스 프록시 — 자동 HTTPS(Let's Encrypt). /etc/caddy/Caddyfile 에 배치.
# 요구: (1) 도메인이 이 서버의 Lightsail 고정 IP를 가리키는 A 레코드, (2) 80·443 포트 개방.
# Caddy가 인증서 발급·갱신을 자동 처리한다. 도메인이 없으면 HTTPS 불가(DEPLOY.md 참고).

# 두 도메인이 같이 쓰는 앱 서빙 블록
(app) {
    # 보안 헤더(2026-10-17) — 삭제(-)는 응답을 쓸 때로 미뤄져 reverse_proxy 가 붙인 값도 지운다
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -Via
    }
    encode zstd gzip
    # 업로드 상한(앱 이미지)와 서버 PREDICT_MAX_UPLOAD_MB를 함께 맞춘다.
    request_body {
        max_size 12MB
    }
    reverse_proxy 127.0.0.1:8000
}

# 웹 본 주소(2026-10-22) — 웹과 API 를 직접 서빙한다. 웹 카카오 로그인은 KAKAO_REDIRECT_URI 가 이 도메인이라 여기로 돌아온다
caretable.kr {
    import app
}

www.caretable.kr {
    redir https://caretable.kr{uri} 302
}

# 깔린 앱·스토어 알림·초대 링크가 쓰는 주소 — 계속 살린다. API 는 그대로 서빙하고 웹 화면만 본 주소로 넘긴다
api.kcalai.link {
    @web not path /api/*
    redir @web https://caretable.kr{uri} 302
    import app
}
