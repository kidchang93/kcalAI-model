# Caddy 리버스 프록시 — 자동 HTTPS(Let's Encrypt). /etc/caddy/Caddyfile 에 배치.
# 요구: (1) 도메인이 이 서버의 Lightsail 고정 IP를 가리키는 A 레코드, (2) 80·443 포트 개방.
# Caddy가 인증서 발급·갱신을 자동 처리한다. 도메인이 없으면 HTTPS 불가(DEPLOY.md 참고).

your.domain.com {
    # 보안 헤더(2026-10-17) — 삭제(-)는 응답을 쓸 때로 미뤄져 reverse_proxy 가 붙인 값도 지운다
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -Via
    }
    encode zstd gzip
    # 업로드 상한(앱 이미지)와 서버 PREDICT_MAX_UPLOAD_MB를 함께 맞춘다.
    request_body {
        max_size 12MB
    }
    reverse_proxy 127.0.0.1:8000
}

# 홍보용 도메인(2026-10-17) — 지금은 api.kcalai.link 로 넘기기만 한다(302: 웹 본 주소를 옮길 때 바꿀 거라 영구 이동으로 굳히지 않는다).
# 웹 카카오 로그인이 KAKAO_REDIRECT_URI(api.kcalai.link) 오리진에 묶여 있어, 여기서 웹을 직접 서빙하면 로그인 팝업이 깨진다.
caretable.kr, www.caretable.kr {
    redir https://api.kcalai.link{uri} 302
}
