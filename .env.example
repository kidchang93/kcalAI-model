# development | production. production이면 기동 시 AUTH_CODE_PEPPER·카카오 설정을 검증한다.
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://kcal:kcal@localhost:5432/kcal
AUTH_SESSION_TTL_DAYS=30
# 세션·연동코드 해시와 OAuth state 서명에 쓰인다. 운영은 반드시 교체 (기본값이면 기동 실패).
AUTH_CODE_PEPPER=change-this-local-secret

# 카카오 로그인 — **유일한 인증 수단**이다. 없으면 아무도 로그인하지 못한다 (production 기동 실패).
# REST API 키는 인가 URL에 실려 나가는 공개값이지만, CLIENT_SECRET·ADMIN_KEY는 진짜 비밀값이다.
# 콘솔: [앱] > [플랫폼 키] > [REST API 키]
KAKAO_REST_API_KEY=
# 콘솔: [앱] > [플랫폼 키] > [REST API 키] > [클라이언트 시크릿] (REST API 키에 딸려 있다)
KAKAO_CLIENT_SECRET=
# 회원 탈퇴 시 연결 끊기(unlink)에 필요하다 — 카카오 로그인 서비스의 의무다.
KAKAO_ADMIN_KEY=
# 콘솔: [앱] > [플랫폼 키] > [REST API 키] > [리다이렉트 URI]
# 등록한 값과 문자 단위로 같아야 한다 (다르면 KOE006). 운영은 https 필수.
# 카카오는 Redirect URI에 커스텀 스킴(kcalairn://)을 등록할 수 없어, 서버가 콜백을 받고
# 앱으로 딥링크를 되돌려준다.
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
APP_DEEPLINK_SCHEME=kcalairn
# KAKAO_TIMEOUT_SECONDS=5

# Sign in with Apple (iOS) — App Store 4.8 의 대안 로그인. 앱이 identity token 을 보내고 서버가 검증한다.
# 번들 ID 는 identity token 의 aud 이자 토큰 교환의 client_id 다.
# APPLE_BUNDLE_ID=com.kcalai.kcalairn
# 아래 셋이 비면 로그인(토큰 검증)은 되지만 **가입은 503** 이다 — 가입 때 authorization code 를
# refresh token 으로 바꿔 둬야 탈퇴 때 Apple 에 폐기를 요청할 수 있다. production 기동은 요구하지 않는다.
# 콘솔: Certificates, Identifiers & Profiles > Keys (Sign in with Apple 체크) — 키 ID 와 .p8
APPLE_TEAM_ID=
APPLE_SIWA_KEY_ID=
# **비밀값.** .p8 파일 내용을 base64 한 줄로: base64 -i AuthKey_XXXX.p8 | tr -d '\n'
# 파일로 두지 않는다 — 배포가 작업 트리를 rsync --delete 해서 서버의 키 파일은 지워진다(.env 는 보존).
APPLE_SIWA_PRIVATE_KEY_B64=
# App Store 인앱 구독 확인 (DATA_MODEL 32-3) — App Store Server API 를 부를 **인앱 결제 키**(SIWA 키와 다른 키).
# 콘솔: App Store Connect > 사용자 및 액세스 > 통합 > 인앱 결제 — 키 ID, 상단의 발급자(Issuer) ID, .p8
# 셋이 비면 /api/billing/appstore/verify 와 알림 재조회가 503 이다(구매 확인 불가). production 기동은 요구하지 않는다.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# **비밀값.** .p8 파일 내용을 base64 한 줄로: base64 -i SubscriptionKey_XXXX.p8 | tr -d '\n'
APPLE_IAP_PRIVATE_KEY_B64=
# 운영은 콤마 구분 명시 목록만 허용된다 (localhost 정규식은 development에서만 적용).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# /api/predict 업로드 상한(MB). 초과 시 413.
PREDICT_MAX_UPLOAD_MB=10
# 민감정보(혈액형·질병·알러지) AES-256-GCM 키. base64(32바이트). 미설정 시 개발 기본키.
# 운영은 반드시 고유값 (미설정 시 APP_ENV=production 기동 실패):
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# HEALTH_ENCRYPTION_KEY=

# 이미지 인식은 Gemini 비전 단일 백엔드다(YOLO 제거). predict에 GEMINI_API_KEY 필요.
# 운영(APP_ENV=production)은 키가 없으면 기동 실패. 키는 로그·응답에 노출하지 않는다.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_TIMEOUT_MS=15000
# GEMINI_MAX_RETRIES=2

# 토스페이먼츠 자동결제(빌링) — **2026-09-29부터 쓰지 않는다**(유료화는 인앱 결제). 비워 두면 /api/billing/* 가
# 503 이 되어 결제가 닫힌다. 운영 기동은 이 키를 더 이상 요구하지 않는다(main.py).
# 콘솔: [내 개발정보] > [API 키] (테스트는 test_, 운영은 live_ 접두)
# **시크릿 키는 이 값만으로 임의 청구가 가능한 비밀값이다** — 앱에 넣지 말고 로그에도 남기지 않는다.
TOSS_SECRET_KEY=
# 결제창 SDK 초기화용 공개값. 서버가 /api/billing/checkout 응답으로 앱에 내려준다.
TOSS_CLIENT_KEY=
# TOSS_TIMEOUT_SECONDS=10


HF_TOKEN=

# 이메일 가입 인증 메일(SMTP — services/mail_client.py). 비우면 이메일 가입·재설정이 503(카카오·Apple 은 그대로).
# 운영은 네이버 메일 SMTP: smtp.naver.com:465, 네이버 메일 환경설정에서 'POP3/SMTP 사용'을 켠다.
# 2단계 인증 계정은 SMTP_PASSWORD 에 '애플리케이션 비밀번호'를 넣는다. 465 외 포트는 STARTTLS 필수.
# 로컬 확인은 mailpit(docker run -e MP_SMTP_AUTH_ACCEPT_ANY=1 -e MP_SMTP_AUTH_ALLOW_INSECURE=1 -p 1025:1025 -p 8025:8025 axllent/mailpit — 기본값은 SMTP 로그인을 안 받는다) + SMTP_HOST=localhost SMTP_PORT=1025, 받은 메일은 http://localhost:8025.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 보낸 사람 주소. 네이버는 로그인 계정과 같아야 한다 — 비우면 SMTP_USERNAME.
MAIL_FROM=
# 발송 계정 전체의 하루(지난 24시간) 인증 메일 한도. 제공자의 하루 발송 한도보다 낮게 둔다.
MAIL_DAILY_LIMIT=300
